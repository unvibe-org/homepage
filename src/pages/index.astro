---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNextEvent, getPastEvents } from "../data/eventHelpers";

const nextEvent = getNextEvent();
const pastEvents = getPastEvents();
const hasUpcoming = nextEvent !== null;

const metaDesc = `We bring hands-on AI coding workshops to your engineering team, on-site at your office. One day takes your engineers from vibe coding to production-ready code with AI agents.`;
const metaDescShort = `AI coding workshops for engineering teams. On-site at your office.`;

// Corporate booking is the single conversion path while positioning is
// per-workshop (no public per-seat tickets on the page for now).
const bookMailto = `mailto:dominik.grusemann@gmail.com?subject=${encodeURIComponent("Workshop for our team")}`;
---

<BaseLayout
    title="unvibe · AI Coding Workshops for Engineering Teams · Munich"
    description={metaDesc}
    canonical="https://unvibe.org"
    ogTitle="unvibe · AI Coding Workshops for Engineering Teams"
    ogDescription={metaDesc}
    ogImage="https://unvibe.org/public/og-image.png?v=2"
    twitterTitle="unvibe · AI Coding Workshops for Engineering Teams"
    twitterDescription={metaDescShort}
    twitterImage="https://unvibe.org/public/twitter-card.png?v=2"
    includeManifest={true}
    ctaUrl={bookMailto}
    ctaLabel="Book a workshop →"
    footerLine={undefined}
>
    <section id="hero">
        <div class="hero-glow"></div>
        <div class="hero-inner">
            <div class="hero-copy">
            <div class="hero-prompt">
                <span class="path">~/workshop</span>
                <span class="cmd">$ run agentic-engineering --mode workshop</span>
            </div>

            <div class="hero-wordmark">
                unvibe<span class="dot">.</span>
            </div>
            <h1 class="hero-tagline">
                AI coding workshops for engineering&nbsp;teams.
            </h1>

            <p class="hero-desc">
                We bring the workshop to your team. In one hands-on day, your
                engineers learn to direct AI agents with real discipline and
                ship code that holds up in production.
            </p>

            <div class="hero-actions">
                <a href={bookMailto} class="btn-primary" data-booking-placement="hero">Book a workshop →</a>
                <a href="#courses" class="btn-ghost">See an example workshop →</a>
            </div>

            {hasUpcoming && (
                <div class="hero-meta">
                    <div class="hero-meta-item">
                        <div class="label">Date</div>
                        <div class="value">{nextEvent.dateDisplay}</div>
                    </div>
                    <div class="hero-meta-item">
                        <div class="label">Time</div>
                        <div class="value">{nextEvent.time}</div>
                    </div>
                    <div class="hero-meta-item">
                        <div class="label">Location</div>
                        <div class="value">{nextEvent.venue}</div>
                    </div>
                </div>
            )}
            </div>

            {/*
              Proof in the hero: the claim lives on the left, the evidence on
              the right. The card is one link that scrolls to
              #recent-workshop; deliberately no button, so "Book a workshop"
              stays the hero's only primary action.
            */}
            <a href="#recent-workshop" class="hero-callout">
                <img
                    src="/public/photos/luca-presenting.jpg"
                    alt="Luca Dombetzki presents at the planqc workshop, beside a slide reading 'Did it move?'"
                    class="hero-callout-photo"
                />
                <div class="hero-callout-body">
                    <img
                        src="/public/logos/planqc.svg"
                        alt="planqc"
                        class="hero-callout-logo"
                    />
                    <p>
                        Our most recent workshop: a full day on-site with
                        planqc's engineering team.
                    </p>
                    <span class="hero-callout-link">See how it went →</span>
                </div>
            </a>
        </div>

        {/*
          EARLY SOCIAL PROOF — attendee-company logos, pinned to the bottom of
          the hero. Nominative use: these are past attendees' EMPLOYERS, not
          clients/sponsors — hence "Engineers from", not "Trusted by".
          Companies validated in
          workshops/research/signals/2026-05-13-luma-registrations.md.
        */}
        <div class="hero-logos">
            <p class="logo-strip-label">Helping engineers from teams at</p>
            <div class="logo-strip-grid">
                <img src="/public/logos/infineon.svg" alt="Infineon" class="logo-wide" />
                <img src="/public/logos/planqc.svg" alt="planqc" class="logo-lockup" />
                <img src="/public/logos/bsh.svg" alt="BSH Hausgeräte" />
                <img src="/public/logos/cocrafter.png" alt="CoCrafter" />
                <img src="/public/logos/qplix.svg" alt="QPLIX" class="logo-stacked" />
            </div>
        </div>
    </section>

    <section id="testimonials">
        <div class="max-w">
            <h2 class="section-title">What people took away.</h2>

            {/*
              Anchor testimonial. Consent received from Alex Kliotzkin (2026-07-01):
              title kept as "Director of Engineering · Infineon" (his call, for
              marketing), figure softened to "hundreds of repos", headshot approved.
              Em dashes removed at his request so it reads like a real quote.
              Quote text is consented verbatim — do not edit.
              Source: workshops/2-marketing/testimonials/tracker.md
            */}
            <div class="quote-card featured">
                <blockquote>
                    "There's so much noise around agentic AI, and a lot of
                    pressure to use it well. The hard part is telling the noise
                    from the actual value. What convinced me was having engineers
                    who've gone deep in the tech and teach tool-agnostic
                    fundamentals you can carry into day-to-day work. My team came
                    back building in an AI-friendly way, and we used it to migrate
                    hundreds of repos at scale."
                </blockquote>
                <div class="quote-attribution">
                    <img
                        src="/public/alex-kliotzkin.jpg"
                        alt="Alex Kliotzkin"
                        class="quote-avatar"
                    />
                    <div>
                        <div class="author">Alex Kliotzkin</div>
                        <div class="role">Director of Engineering · Infineon</div>
                    </div>
                    {/*
                      Nominative use: Infineon is Alex's stated employer, shown
                      with his consented attribution (same basis as the hero
                      logo strip). Not a client/sponsor claim.
                    */}
                    <img
                        src="/public/logos/infineon.svg"
                        alt="Infineon"
                        class="quote-logo"
                    />
                </div>
            </div>

        </div>
    </section>

    <section id="recent-workshop">
        <div class="max-w">
            {/*
              Most recent private workshop, the proof point for the per-workshop
              corporate offer this page leads with. Its own section rather than
              part of testimonials (review feedback 2026-08-15: a client story
              is not a takeaway). Facts from
              workshops/3-workshops/2026-08-07-planqc-onsite/schedule/schedule.md
              (Fri 7 Aug 2026, planqc HQ, full day). Deliberately no headcount:
              the schedule says "10-12" and nobody wrote down the actual number.
              Deliberately no "their codebase": the day ran on a provided project
              (PaperClaw, re-themed onto participants' own scientific papers,
              see project/briefing-documents/README.md), not on planqc's code.
              Logo is planqc's own asset, used to name them as a client. They
              have confirmed they are happy to be listed (also in the hero
              logo strip).
            */}
            <h2 class="section-title">Our most recent workshop.</h2>

            <div class="client-proof">
                <div class="client-note">
                    <a
                        href="https://planqc.eu"
                        class="client-logo"
                        target="_blank"
                        rel="noopener"
                        aria-label="planqc"
                    >
                        <img src="/public/logos/planqc.svg" alt="planqc" />
                    </a>
                    <p class="client-detail">
                        We spent a full day on-site at planqc HQ with their
                        engineering team, working plan-first with agents from
                        the first milestone on a project built around their
                        own scientific papers.
                    </p>
                </div>
                {/*
                  Photo from the closing session of the planqc day: Dominik
                  presenting the sub-agents debrief.
                */}
                <figure class="client-photo">
                    <img
                        src="/public/photos/planqc-onsite.jpg"
                        alt="Dominik Grusemann points at a slide reading 'You've been running subagents since 09:30' at the planqc workshop"
                    />
                </figure>
            </div>

        </div>
    </section>

    <section id="audience">
        <div class="max-w">
            <h2 class="section-title">Who is this for?</h2>
            <p class="section-desc">
                Working engineers. The day goes best with a team that looks
                roughly like this.
            </p>

            <div class="audience-card">
                <ul class="audience-list">
                    <li>They write code most days.</li>
                    <li>
                        They already use Claude Code, Copilot, or something
                        similar.
                    </li>
                    <li>
                        They work in a real codebase, with tests, reviews, and
                        history.
                    </li>
                    <li>
                        They want to decide the architecture while agents do
                        the typing.
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <section id="instructors">
        <div class="max-w">
            {/* "Mixture of experts" is a deliberate MoE pun for this
                audience; keep it intact when editing. */}
            <h2 class="section-title">Taught by a mixture of experts.</h2>
            <p class="section-desc">
                All four of us ship production code with AI daily.
            </p>

            <div class="instructor-grid">
                <div class="instructor-card">
                    <img
                        src="/public/traun-leyden.jpg"
                        alt="Traun Leyden"
                        class="instructor-avatar"
                    />
                    <h3>Traun Leyden</h3>
                    <p>
                        20+ years shipping backend systems, previously at
                        Databricks and Couchbase. Co-founder of Fluensy.
                    </p>
                    <a href="https://fluensy.app/" class="instructor-company"
                        >fluensy.app</a
                    >
                    <a
                        href="https://www.linkedin.com/in/tleyden/"
                        class="instructor-handle"
                        target="_blank"
                        aria-label="Traun Leyden on LinkedIn"
                        ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg
                        ></a
                    >
                </div>
                <div class="instructor-card">
                    <img
                        src="/public/adam-charnock.jpg"
                        alt="Adam Charnock"
                        class="instructor-avatar"
                    />
                    <h3>Adam Charnock</h3>
                    <p>
                        20 years in production, previously at Twitter and
                        Blocknative. Founder of Lithus, managed bare-metal
                        Kubernetes in the EU.
                    </p>
                    <a href="https://lithus.eu" class="instructor-company"
                        >lithus.eu</a
                    >
                    <a
                        href="https://www.linkedin.com/in/adamcharnock/"
                        class="instructor-handle"
                        target="_blank"
                        aria-label="Adam Charnock on LinkedIn"
                        ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg
                        ></a
                    >
                </div>
                <div class="instructor-card">
                    <img
                        src="/public/dominik-grusemann.jpg"
                        alt="Dominik Grusemann"
                        class="instructor-avatar"
                    />
                    <h3>Dominik Grusemann</h3>
                    <p>
                        Ex-CTO of Chatchamp, acquired 2023, and previously BMW
                        autonomous driving. Co-founder of Langmail.
                    </p>
                    <a
                        href="https://langmail.me/"
                        class="instructor-company">langmail.me</a
                    >
                    <a
                        href="https://www.linkedin.com/in/dominikgrusemann/"
                        class="instructor-handle"
                        target="_blank"
                        aria-label="Dominik Grusemann on LinkedIn"
                        ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg
                        ></a
                    >
                </div>
                <div class="instructor-card">
                    <img
                        src="/public/luca-dombetzki.jpg"
                        alt="Luca Dombetzki"
                        class="instructor-avatar"
                    />
                    <h3>Luca Dombetzki</h3>
                    <p>
                        Built TUM.ai, Europe's largest AI student initiative.
                        Senior Machine Learning Engineer at Valinor Discovery,
                        virtual patient models for medicine.
                    </p>
                    <a
                        href="https://valinordiscovery.com/"
                        class="instructor-company">valinordiscovery.com</a
                    >
                    <a
                        href="https://www.linkedin.com/in/luca-dombetzki"
                        class="instructor-handle"
                        target="_blank"
                        aria-label="Luca Dombetzki on LinkedIn"
                        ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg
                        ></a
                    >
                </div>
            </div>

        </div>
    </section>

    <section id="courses">
        <div class="max-w">
            <h2 class="section-title">An example workshop.</h2>
            <p class="section-desc">
                One example of a day we run. We adjust the content to match
                your team and your stack.
            </p>

            <div class="course-panel">
                <p class="course-pitch">
                    The full-day workshop is built around one hard problem.
                    Your engineers receive a project and a goal, and we work
                    beside them as they direct Claude Code from the first
                    plan to working, verified code. We run it at your office,
                    and everyone leaves with techniques they can use the next
                    morning.
                </p>

                <h3 class="course-subhead">What your team leaves knowing</h3>
                <div class="learn-grid">
                    <div class="learn-item">Context engineering: CLAUDE.md files and skills the agent follows</div>
                    <div class="learn-item">Driving agents to consistent, high-quality output</div>
                    <div class="learn-item">Splitting work to fit the agent's context window</div>
                    <div class="learn-item">Test loops and review workflows that keep up with AI-speed PRs</div>
                    <div class="learn-item">Git branches and worktrees for agent-driven workflows</div>
                    <div class="learn-item">Knowing what to delegate and what to do yourself</div>
                </div>

                <div class="course-actions">
                    <a href={bookMailto} class="btn-primary" data-booking-placement="workshop_example">Book a workshop →</a>
                    <a href="/guide/" class="btn-ghost">Download the free guide →</a>
                </div>
            </div>

            <div class="section-photo-pair">
                <figure class="photo-portrait">
                    <img
                        src="/public/photos/planqc-room-laughing.jpg"
                        alt="Participants around a table at the planqc workshop, laughing as one of them raises a hand to answer"
                        loading="lazy"
                    />
                </figure>
                <figure class="photo-landscape">
                    <img
                        src="/public/photos/planqc-participants.jpg"
                        alt="Two participants work at their laptops during the planqc workshop, one of them typing into an editor full of code"
                        loading="lazy"
                    />
                </figure>
            </div>
        </div>
    </section>

    <section id="core-info">
        <div class="max-w">
            {/*
              The practical facts of the offer, pulled out of the example
              workshop (review feedback 2026-08-15: this is the core info and
              deserves its own section near the FAQ).
            */}
            <h2 class="section-title">The core info.</h2>

            <div class="course-facts">
                <div class="fact">
                    <span class="key">Format</span>
                    <span class="val amber">Private workshop for your team</span>
                </div>
                <div class="fact">
                    <span class="key">Length</span>
                    <span class="val">One full day</span>
                </div>
                <div class="fact">
                    <span class="key">Size</span>
                    <span class="val">Up to 20 engineers</span>
                </div>
                <div class="fact">
                    <span class="key">Where</span>
                    <span class="val">On-site at your office</span>
                </div>
                <div class="fact">
                    <span class="key">Pricing</span>
                    <span class="val">Per workshop · get a quote</span>
                </div>
            </div>

            <p class="core-info-note">
                This is our standard format, but talk to us if your team
                needs a different shape.
            </p>
        </div>
    </section>

    <section id="faq">
        <div class="max-w">
            <h2 class="section-title">Quick answers.</h2>

            <div class="faq-list">
                <details class="faq-item">
                    <summary>Do you offer remote?</summary>
                    <p>
                        Today we run the workshop on-site at your office. A
                        remote format is something we are looking into, and
                        you can ask us where it stands.
                    </p>
                </details>
                <details class="faq-item">
                    <summary>How many engineers can join?</summary>
                    <p>
                        Up to 20 per workshop. Everyone needs a seat, a desk,
                        and power for the hands-on time, so the room needs to
                        hold that many comfortably.
                    </p>
                </details>
                <details class="faq-item">
                    <summary>Can we use our own codebase?</summary>
                    <p>
                        We teach on a greenfield project we bring with us, which
                        suits a workshop day better, as everyone starts from the
                        same place. The techniques are what your engineers take
                        away, and they can apply them in your codebase the next
                        day.
                    </p>
                </details>
                <details class="faq-item">
                    <summary>What level do our engineers need?</summary>
                    <p>
                        Comfort reading and writing code is the baseline, and no
                        prior agent experience is needed. We run a few calls
                        with you beforehand so we can tailor the day to the
                        skill levels in the room.
                    </p>
                </details>
                <details class="faq-item">
                    <summary>Which tools do you use?</summary>
                    <p>
                        We focus on Claude Code and stay flexible about what
                        your engineers already use. Everyone needs their own
                        subscription, so please make sure the team has access
                        before the day.
                    </p>
                </details>
                <details class="faq-item">
                    <summary>How do we book?</summary>
                    <p>
                        Email <a href="mailto:dominik.grusemann@gmail.com"
                            >dominik.grusemann@gmail.com</a
                        > with your team size and rough dates. We'll scope it and
                        send a quote.
                    </p>
                </details>
            </div>
        </div>
    </section>

    <section id="updates">
        <div class="max-w">
            <h2 class="section-title">Get updates by email.</h2>
            <p class="section-desc" style="margin-bottom: 32px">
                We send dates for open sessions, the Advanced AI Coding
                launch, and occasional field notes.
            </p>

            <form class="signup-form ml-form" method="POST">
                <div class="signup-prompt">
                    <span class="signup-path">~/updates</span>&nbsp;$&nbsp;
                </div>
                <div class="signup-input-wrap">
                    <input
                        type="email"
                        name="fields[email]"
                        class="signup-input"
                        placeholder="your@email.dev"
                        required
                        autocomplete="email"
                        aria-label="Email address"
                    />
                    <button type="submit" class="btn-ghost signup-btn">
                        subscribe
                    </button>
                </div>
                <input type="hidden" name="ml-submit" value="1" />
                <input type="hidden" name="anticsrf" value="true" />
            </form>

            <div class="signup-feedback"></div>

            <p class="signup-consent">
                By subscribing you agree to our
                <a href="/privacy/">privacy policy</a>. We store your email
                with
                <a
                    href="https://www.mailerlite.com"
                    target="_blank"
                    rel="noopener">MailerLite</a
                >
                (EU-based) and you can unsubscribe anytime.
            </p>
        </div>
    </section>

    <section id="sponsors">
        <div class="max-w">
            <p class="logo-strip-label">Supported by</p>
            <div class="sponsor-grid">
                {(nextEvent?.sponsors ?? pastEvents[0]?.sponsors ?? []).map((s) => (
                    <a
                        href={s.url}
                        class="sponsor-link"
                        target="_blank"
                        rel="noopener"
                        aria-label={s.name}
                    >
                        <img src={s.logo} alt={s.name} />
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section id="final-cta">
        <div class="max-w" style="position: relative">
            <div class="cta-terminal">
                <span class="path">~/workshop</span>&nbsp;$&nbsp;<span
                    >book --workshop</span
                >
            </div>
            <h2 class="cta-title">
                Done vibe coding?<br />Train your team.
            </h2>
            <div
                style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;"
            >
                <a href={bookMailto} class="btn-primary" data-booking-placement="final_cta">Book a workshop →</a>
                <a href="#courses" class="btn-ghost">See an example workshop →</a>
            </div>
        </div>
    </section>
</BaseLayout>

<script is:inline>
    (function () {
        document.querySelectorAll("[data-booking-placement]").forEach(function (link) {
            link.addEventListener("click", function () {
                window.posthog?.capture("workshop_booking_initiated", {
                    placement: link.dataset.bookingPlacement,
                });
            });
        });

        /* MailerLite signup */
        document.querySelectorAll(".ml-form").forEach(function (form) {
            var feedback = form.parentElement.querySelector(
                ".signup-feedback",
            );

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                var email = form.querySelector('[name="fields[email]"]');
                if (!email.value || !email.validity.valid) {
                    feedback.textContent =
                        "→ please enter a valid email address";
                    feedback.className = "signup-feedback error";
                    return;
                }

                var btn = form.querySelector(".signup-btn");
                var originalLabel = btn.textContent;
                btn.textContent = "sending…";
                btn.disabled = true;

                fetch(
                    "https://assets.mailerlite.com/jsonp/2239840/forms/183629273017354022/subscribe",
                    {
                        method: "POST",
                        body: new FormData(form),
                    },
                )
                    .then(function () {
                        feedback.textContent =
                            "✓ subscribed, you're on the list";
                        feedback.className = "signup-feedback success";
                        window.posthog?.capture("newsletter_subscription_completed", {
                            placement: "homepage",
                        });
                        form.reset();
                        btn.textContent = "done ✓";
